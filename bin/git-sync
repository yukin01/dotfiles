#!/bin/bash
set -euo pipefail

green='\033[32m'
yellow='\033[33m'
red='\033[31m'
dim='\033[2m'
reset='\033[0m'

info() { printf "${green}▶${reset} %s\n" "$1"; }
ok()   { printf "${green}✓${reset} %s\n" "$1"; }
warn() { printf "${yellow}!${reset} %s\n" "$1" >&2; }
err()  { printf "${red}✗${reset} %s\n" "$1" >&2; }

info "Switching to main"
if ! git switch main --quiet 2>/dev/null; then
  err "Failed to switch to main (uncommitted changes?)"
  exit 1
fi

info "Pulling latest"
if ! pull_output=$(git pull --quiet 2>&1); then
  err "Failed to pull"
  printf "  %s\n" "$pull_output" >&2
  exit 1
fi
ok "main is up to date"

info "Fetching & pruning"
git fetch --prune --quiet

# git branch -vv は他 worktree でチェックアウト中のブランチに "+" を付けるため、
# for-each-ref でブランチ名と upstream 状態を直接取得する
gone_branches=$(git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads \
  | awk '$2 == "[gone]" {print $1}') || true

# 他 worktree でチェックアウト中のブランチは削除できないためスキップする
worktree_branches=$(git worktree list --porcelain | sed -n 's|^branch refs/heads/||p')

if [[ -z "$gone_branches" ]]; then
  ok "No stale branches"
else
  count=0
  while IFS= read -r branch; do
    if grep -qxF "$branch" <<< "$worktree_branches"; then
      warn "Skipped $branch (checked out in a worktree)"
      continue
    fi
    if git branch -D "$branch" >/dev/null 2>&1; then
      printf "  ${dim}deleted${reset} %s\n" "$branch"
      count=$((count + 1))
    else
      warn "Failed to delete $branch"
    fi
  done <<< "$gone_branches"
  ok "Removed $count branch(es)"
fi
